#!/usr/bin/env bash

set -Eeuo pipefail

SOURCE_DIR={{ .chezmoi.sourceDir | quote }}
REPO_ROOT="$(git -C "$SOURCE_DIR" rev-parse --show-toplevel)"
PACKAGE_INSTALLER="$REPO_ROOT/packages/install.sh"
OH_MY_ZSH_INSTALLER="$REPO_ROOT/scripts/install-oh-my-zsh.sh"
OH_MY_ZSH_REVISION_FILE="$REPO_ROOT/versions/oh-my-zsh"
EDITOR_STATE_CHECKER="$REPO_ROOT/scripts/check-editor-state.sh"
RUNTIME_MANAGER="$REPO_ROOT/scripts/manage-runtime-versions.sh"
BOOTSTRAP_STATE_CHECKER="$REPO_ROOT/scripts/check-bootstrap-tools.sh"
BOOTSTRAP_INSTALLER="$REPO_ROOT/scripts/install-bootstrap-tool.sh"
MACHINE_ROLE={{ .machineRole | quote }}
HOST_TYPE={{ .hostType | quote }}
UPDATE_CAN_CONVERGE=false

usage() {
    cat <<'EOF'
Usage: dotconfig <command>

Commands:
  status    Show repository, dotfile, and package drift.
  doctor    Check configuration prerequisites and report problems.
  apply     Apply the currently checked-out configuration.
  update    Fast-forward the repository, show the diff, and apply after confirmation.
  sync      Update, then converge runtimes, Oh My Zsh, Vim plugins, and CoC.
  packages  Apply or inspect the native package baseline.
  bootstrap Install the reviewed chezmoi and mise versions.
  runtimes  Install the pinned language runtimes.
  shell     Install the pinned Oh My Zsh revision.
  vim        Install the pinned Vim plugins and CoC extensions.
  private   Create or edit the active role's private shell file.
  path      Print the source repository path.
EOF
}

dotfile_drift() {
    chezmoi --source "$REPO_ROOT" diff
}

package_check() {
    bash "$PACKAGE_INSTALLER" --check
}

shell_status() {
    local expected
    local actual
    expected="$(tr -d '[:space:]' < "$OH_MY_ZSH_REVISION_FILE")"

    if [[ ! -d "$HOME/.oh-my-zsh/.git" ]]; then
        echo "missing: Oh My Zsh" >&2
        return 1
    fi

    actual="$(git -C "$HOME/.oh-my-zsh" rev-parse HEAD)"
    if [[ "$actual" != "$expected" ]]; then
        echo "Oh My Zsh drift: expected $expected, found $actual" >&2
        return 1
    fi
    echo "Oh My Zsh: $actual"
}

runtime_status() {
    if ! command -v mise >/dev/null 2>&1; then
        echo "missing: mise" >&2
        return 1
    fi
    bash "$RUNTIME_MANAGER" status
}

private_files() {
    printf '%s\n' \
        "$HOME/.zshrc.local" \
        "$HOME/.zshrc.$MACHINE_ROLE.local"
}

private_permissions_check() {
    local failures=0
    local private_file

    while IFS= read -r private_file; do
        [[ -e "$private_file" ]] || continue
        if [[ ! -f "$private_file" ]]; then
            echo "warning: private configuration is not a regular file: $private_file" >&2
            failures=$((failures + 1))
        elif [[ -n "$(find "$private_file" -perm -077 -print)" ]]; then
            echo "warning: private configuration is readable or writable by other users: $private_file" >&2
            failures=$((failures + 1))
        else
            echo "ok: private configuration permissions: $private_file"
        fi
    done < <(private_files)

    return "$failures"
}

private_command() {
    local private_file="$HOME/.zshrc.$MACHINE_ROLE.local"
    local editor="${VISUAL:-${EDITOR:-vim}}"

    if [[ ! -e "$private_file" ]]; then
        umask 077
        : > "$private_file"
        echo "Created $private_file"
    elif [[ ! -f "$private_file" ]]; then
        echo "Refusing to replace non-regular path: $private_file" >&2
        return 1
    fi

    chmod 600 "$private_file"
    "$editor" "$private_file"
}

vim_install() {
    bash "$REPO_ROOT/scripts/converge-vim.sh"
}

bootstrap_install() {
    bash "$BOOTSTRAP_INSTALLER" mise
    bash "$BOOTSTRAP_INSTALLER" chezmoi
    export PATH="$HOME/.local/bin:$PATH"
    bash "$BOOTSTRAP_STATE_CHECKER"
}

runtime_install() {
    command -v mise >/dev/null 2>&1 || {
        echo "missing: mise; rerun the repository installer" >&2
        return 1
    }
    bash "$RUNTIME_MANAGER" install
}

status_command() {
    local failures=0
    local drift

    echo "Platform: $(uname -s) $(uname -m)"
    echo "Profile: $MACHINE_ROLE / $HOST_TYPE"
    echo "Repository: $REPO_ROOT"
    git -C "$REPO_ROOT" status --short --branch
    if [[ "$(git -C "$REPO_ROOT" config --local --get dotconfig.reviewedHead || true)" != "$(git -C "$REPO_ROOT" rev-parse HEAD)" ]]; then
        echo "Repository changes await review; run: dotconfig update" >&2
        failures=$((failures + 1))
    fi

    echo
    echo "Dotfile drift:"
    drift="$(dotfile_drift)"
    if [[ -n "$drift" ]]; then
        printf '%s\n' "$drift"
        failures=$((failures + 1))
    else
        echo "none"
    fi

    echo
    echo "Package drift:"
    if ! package_check; then
        failures=$((failures + 1))
    fi

    echo
    echo "Bootstrap tools:"
    if ! bash "$BOOTSTRAP_STATE_CHECKER"; then
        failures=$((failures + 1))
    fi

    echo
    echo "Runtime versions:"
    if ! runtime_status; then
        failures=$((failures + 1))
    fi

    echo
    echo "Oh My Zsh:"
    if ! shell_status; then
        failures=$((failures + 1))
    fi

    echo
    echo "Editor dependencies:"
    if ! bash "$EDITOR_STATE_CHECKER"; then
        failures=$((failures + 1))
    fi

    if ((failures > 0)); then
        echo "$failures state check(s) report drift" >&2
        return 1
    fi
}

doctor_command() {
    local failures=0
    local command_name

    echo "Platform: $(uname -s) $(uname -m)"
    echo "Profile: $MACHINE_ROLE / $HOST_TYPE"
    echo "Repository: $REPO_ROOT"

    for command_name in bash chezmoi git mise vim zsh; do
        if command -v "$command_name" >/dev/null 2>&1; then
            printf 'ok: %s (%s)\n' "$command_name" "$(command -v "$command_name")"
        else
            printf 'missing: %s\n' "$command_name" >&2
            failures=$((failures + 1))
        fi
    done

    if [[ -n "$(git -C "$REPO_ROOT" status --porcelain)" ]]; then
        echo "warning: source repository has uncommitted changes" >&2
        failures=$((failures + 1))
    else
        echo "ok: source repository is clean"
    fi

    if [[ -n "$(dotfile_drift)" ]]; then
        echo "warning: managed dotfiles differ from source state" >&2
        failures=$((failures + 1))
    else
        echo "ok: managed dotfiles match source state"
    fi

    if package_check; then
        echo "ok: package baseline is satisfied"
    else
        failures=$((failures + 1))
    fi

    if ! bash "$BOOTSTRAP_STATE_CHECKER"; then
        failures=$((failures + 1))
    fi

    if runtime_status; then
        echo "ok: pinned runtimes are installed"
    else
        failures=$((failures + 1))
    fi

    if ! shell_status; then
        failures=$((failures + 1))
    fi

    if ! bash "$EDITOR_STATE_CHECKER"; then
        failures=$((failures + 1))
    fi

    if ! private_permissions_check; then        failures=$((failures + 1))
    fi

    if ((failures > 0)); then
        echo "$failures check(s) need attention" >&2
        return 1
    fi
    echo "all checks passed"
}

apply_command() {
    chezmoi --source "$REPO_ROOT" diff
    chezmoi --source "$REPO_ROOT" apply --verbose
}

update_command() {
    if [[ -n "$(git -C "$REPO_ROOT" status --porcelain)" ]]; then
        echo "Refusing to update a repository with uncommitted changes: $REPO_ROOT" >&2
        exit 1
    fi

    local old_head
    local new_head
    local reviewed_head
    local diff_base
    local drift
    old_head="$(git -C "$REPO_ROOT" rev-parse HEAD)"
    git -C "$REPO_ROOT" pull --ff-only
    new_head="$(git -C "$REPO_ROOT" rev-parse HEAD)"
    reviewed_head="$(git -C "$REPO_ROOT" config --local --get dotconfig.reviewedHead || true)"
    [[ "$reviewed_head" =~ ^[0-9a-f]{40}$ ]] || reviewed_head=""

    drift="$(dotfile_drift)"
    if [[ "$reviewed_head" == "$new_head" && -z "$drift" ]]; then
        echo "Repository and managed dotfiles are already current."
        UPDATE_CAN_CONVERGE=true
        package_check || true
        return
    fi

    if [[ "$reviewed_head" != "$new_head" ]]; then
        diff_base="$old_head"
        if [[ -n "$reviewed_head" ]] && git -C "$REPO_ROOT" merge-base --is-ancestor "$reviewed_head" "$new_head"; then
            diff_base="$reviewed_head"
        fi
        if [[ "$diff_base" != "$new_head" ]]; then
            echo "Repository changes awaiting review ($diff_base..$new_head):"
            git -C "$REPO_ROOT" --no-pager diff "$diff_base" "$new_head"
        else
            echo "Repository revision has not been reviewed on this machine:"
            git -C "$REPO_ROOT" --no-pager show --stat --oneline "$new_head"
        fi
    fi

    if [[ -n "$drift" ]]; then
        echo "Managed dotfile changes:"
        printf '%s\n' "$drift"
    fi

    if [[ -t 0 ]]; then
        printf 'Accept these changes and apply managed dotfiles? [y/N] '
        read -r answer
        [[ "$answer" == [yY] || "$answer" == [yY][eE][sS] ]] || {
            echo "Not applied."
            return
        }
    else
        echo "Non-interactive session: refusing to apply or converge without confirmation." >&2
        exit 1
    fi

    if [[ -n "$drift" ]]; then
        chezmoi --source "$REPO_ROOT" apply --verbose
    fi
    git -C "$REPO_ROOT" config --local dotconfig.reviewedHead "$new_head"
    UPDATE_CAN_CONVERGE=true
    package_check || true
}

sync_command() {
    update_command
    if ! "$UPDATE_CAN_CONVERGE"; then
        echo "Sync stopped because the configuration update was not applied."
        return
    fi

    echo
    echo "Converging pinned runtimes..."
    runtime_install

    echo
    echo "Converging Oh My Zsh..."
    bash "$OH_MY_ZSH_INSTALLER"

    echo
    echo "Converging Vim plugins and CoC extensions..."
    vim_install

    echo
    echo "Machine configuration is synchronized."
    package_check || {
        echo "Native package drift remains; run: dotconfig packages" >&2
    }
}

case "${1:-}" in
    status) status_command ;;
    doctor) doctor_command ;;
    apply) apply_command ;;
    update) update_command ;;
    sync) sync_command ;;
    packages) shift; bash "$PACKAGE_INSTALLER" "$@" ;;
    bootstrap) bootstrap_install ;;
    runtimes) runtime_install ;;
    shell) bash "$OH_MY_ZSH_INSTALLER" ;;
    vim) vim_install ;;
    private) private_command ;;
    path) printf '%s\n' "$REPO_ROOT" ;;
    -h|--help|"") usage ;;
    *) echo "Unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
