# User-local commands managed by this repository.
export PATH="$HOME/.local/bin:$PATH"

# Chezmoi machine profile. Sensitive values stay in untracked local files.
export DOTCONFIG_ROLE={{ .machineRole | quote }}
export DOTCONFIG_HOST_TYPE={{ .hostType | quote }}

# Oh My Zsh is installed by the repository bootstrap.
export ZSH="${HOME}/.oh-my-zsh"
ZSH_THEME="robbyrussell"

dotconfig_zsh_dir="${HOME}/.config/zsh"
source "${dotconfig_zsh_dir}/common.zsh"

case "$OSTYPE" in
    darwin*) source "${dotconfig_zsh_dir}/darwin.zsh" ;;
    linux-gnu*) source "${dotconfig_zsh_dir}/linux.zsh" ;;
esac

source "${ZSH}/oh-my-zsh.sh"

# Activate repository-managed language runtimes.
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate zsh)"
fi

# iTerm2 integration is optional and macOS-specific.
if [[ "$OSTYPE" == darwin* && -r "${HOME}/.iterm2_shell_integration.zsh" ]]; then
    source "${HOME}/.iterm2_shell_integration.zsh"
fi

# Per-machine and per-role customization remains deliberately unmanaged.
[[ -r "${HOME}/.zshrc.local" ]] && source "${HOME}/.zshrc.local"
role_config="${HOME}/.zshrc.${DOTCONFIG_ROLE}.local"
[[ -r "$role_config" ]] && source "$role_config"

unset dotconfig_zsh_dir role_config
